{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "description": "One guard condition: ``field op value``.",
      "properties": {
        "field": {
          "pattern": "^(task_kind|step_kind|step_index|params\\.[A-Za-z_][A-Za-z0-9_]{0,63})$",
          "title": "Field",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/GuardOp"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/RangeValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Guard": {
      "additionalProperties": false,
      "description": "Conjunction of conditions. A skill fires only when every condition holds.",
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1,
          "title": "All",
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "Guard",
      "type": "object"
    },
    "GuardOp": {
      "description": "The only guard operators. There is no regex and no eval.",
      "enum": [
        "eq",
        "in",
        "range",
        "has_type",
        "exists"
      ],
      "title": "GuardOp",
      "type": "string"
    },
    "RangeValue": {
      "additionalProperties": false,
      "description": "Inclusive numeric range.",
      "properties": {
        "max": {
          "title": "Max",
          "type": "number"
        },
        "min": {
          "title": "Min",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "RangeValue",
      "type": "object"
    },
    "SkillStep": {
      "additionalProperties": false,
      "description": "A templated action. String args may contain ``{slot}`` or ``{slot|filter}``.",
      "properties": {
        "args": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Args",
          "type": "object"
        },
        "step_kind": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Step Kind",
          "type": "string"
        },
        "tool": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "step_kind"
      ],
      "title": "SkillStep",
      "type": "object"
    },
    "Slot": {
      "additionalProperties": false,
      "description": "A typed slot bound to a situation field.",
      "properties": {
        "source": {
          "pattern": "^(task_kind|step_kind|step_index|params\\.[A-Za-z_][A-Za-z0-9_]{0,63})$",
          "title": "Source",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SlotType"
        }
      },
      "required": [
        "type",
        "source"
      ],
      "title": "Slot",
      "type": "object"
    },
    "SlotType": {
      "description": "Types a skill slot may take.",
      "enum": [
        "identifier",
        "path",
        "string",
        "int"
      ],
      "title": "SlotType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A declarative skill: data interpreted by the executor, never code.",
  "properties": {
    "guard": {
      "$ref": "#/$defs/Guard"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9\\-]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slots": {
      "additionalProperties": {
        "$ref": "#/$defs/Slot"
      },
      "title": "Slots",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SkillStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "task_kind": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
      "title": "Task Kind",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "task_kind",
    "guard",
    "steps"
  ],
  "title": "Skill",
  "type": "object"
}
